{
  "manifest_version": 3,
  "name": "Resume Optimizer",
  "version": "1.0.0",
  "description": "Optimize your LaTeX resume for job descriptions using AI",
  "action": {
    "default_title": "Resume Optimizer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": ["storage", "sidePanel"]
}
